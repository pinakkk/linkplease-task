# Base URL of the LinkPlease FastAPI backend (no trailing slash).
#
# This is read at BUILD time and inlined into the client bundle — it is public
# by design (the dashboard polls the backend directly from the browser), so it
# must never hold a secret. Changing it requires a rebuild, not just a restart.
#
# Local development against a backend on the host machine:
NEXT_PUBLIC_API_BASE=http://localhost:8000
#
# Deployed (Cloudflare Workers via @opennextjs/cloudflare) — point at Fly:
# NEXT_PUBLIC_API_BASE=https://linkplease-backend.fly.dev
#
# The backend must allow this frontend's origin via CORS on /api/*, /stats,
# /rules and /healthz (BLUEPRINT §6). If the variable is unset the client falls
# back to http://localhost:8000.
