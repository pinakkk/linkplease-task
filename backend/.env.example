# LinkPlease backend configuration.
# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).

# --- REQUIRED: get this yourself from PseudoGram --------------------------
#   1. POST https://pseudogram-api.onrender.com/v1/apply   (your real details)
#   2. POST https://pseudogram-api.onrender.com/v1/keygen  {"email":"..."}
# This key is BOTH the X-API-Key for outbound calls AND the HMAC secret used
# to verify inbound webhook signatures. Without it, signature verification
# rejects every webhook (401) and every DM send is unauthenticated.
PSEUDOGRAM_API_KEY=

# --- REQUIRED in production (Fly sets this automatically on attach) -------
DATABASE_URL=postgresql://pinak@localhost:5432/linkplease

# --- Optional -------------------------------------------------------------
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com
# Our own public URL, used to point the simulator back at us.
PUBLIC_BASE_URL=https://linkplease-backend.fly.dev
# Their limit is 10/60s; we spend 9 and bank one for clock skew.
RATE_LIMIT_MAX=9
RATE_LIMIT_WINDOW_SECONDS=60
MAX_ATTEMPTS=5
MAX_CYCLES=3
# Set to 0 ONLY for local tests without a key. Production must verify.
VERIFY_SIGNATURES=1
# Phase 3 calibration switch: "rule_user" | "rule_user_plus_events"
DUPLICATES_FORMULA=rule_user
CORS_ORIGINS=*
